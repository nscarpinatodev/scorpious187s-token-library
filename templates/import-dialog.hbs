<div class="stl-editor">

  {{!-- Scrolls on its own so the Add button stays on screen. --}}
  <div class="stl-editor-scroll">

    <p class="stl-meta">
      {{localize "STL.Import.Target"}}: <strong>{{categoryLabel}}</strong>
      {{#if targetDir}}<code>{{targetDir}}</code>{{/if}}
    </p>

    {{#unless tokenizer}}
      <p class="stl-warning">
        <i class="fas fa-triangle-exclamation"></i> {{localize "STL.Import.NoTokenizer"}}
      </p>
    {{/unless}}

    <div class="stl-dropzone">
      <i class="fas fa-cloud-arrow-up"></i>
      <p>{{localize "STL.Import.DropHere"}}</p>
      <div class="stl-dropzone-actions">
        <button type="button" data-action="pickFiles">
          <i class="fas fa-folder-open"></i> {{localize "STL.Import.PickFiles"}}
        </button>
        <button type="button" data-action="browseData">
          <i class="fas fa-link"></i> {{localize "STL.Import.LinkExisting"}}
        </button>
      </div>
    </div>

    {{#if hasQueue}}
      <fieldset class="stl-fieldset">
        <legend>{{localize "STL.Import.Queued"}} ({{queue.length}})</legend>
        <ul class="stl-queue">
          {{#each queue}}
            <li>
              <span class="stl-queue-name">
                {{#if this.fromDisk}}<i class="fas fa-link" data-tooltip="{{localize 'STL.Import.Linked'}}"></i>{{/if}}
                {{this.name}}
              </span>
              <span class="stl-queue-facets">{{this.facets}}</span>
              <button type="button" class="stl-chip-remove" data-action="removeFile" data-index="{{this.index}}"
                      data-tooltip="{{localize 'STL.Common.Remove'}}">
                <i class="fas fa-xmark"></i>
              </button>
            </li>
          {{/each}}
        </ul>
      </fieldset>
    {{/if}}

    {{#if hasSuggestions}}
      <fieldset class="stl-fieldset">
        <legend>{{localize "STL.Import.NewValues"}}</legend>
        <p class="hint">{{localize "STL.Import.NewValuesHint"}}</p>
        <ul class="stl-suggestions">
          {{#each suggestions}}
            <li>
              <button type="button"
                      class="stl-chip{{#if this.accepted}} selected{{/if}}"
                      data-action="toggleToken"
                      data-token="{{this.token}}">{{this.token}}</button>
              {{#if this.accepted}}
                <select name="tokenFacet.{{this.token}}">
                  {{#each ../facets}}
                    <option value="{{this.id}}" {{#if (stl-eq this.id ../this.facetId)}}selected{{/if}}>
                      {{this.label}}
                    </option>
                  {{/each}}
                </select>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      </fieldset>
    {{/if}}

  </div>

  <footer class="stl-editor-actions">
    <button type="submit" class="stl-primary" {{#if busy}}disabled{{/if}}>
      {{#if busy}}
        <i class="fas fa-spinner fa-spin"></i> {{localize "STL.Import.Working"}}
      {{else}}
        <i class="fas fa-file-import"></i> {{localize "STL.Import.Add"}}
      {{/if}}
    </button>
  </footer>
</div>
