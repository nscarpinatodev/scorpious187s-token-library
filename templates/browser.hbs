{{!--
  Token library browser.
  Categories left, filters + grid right, tag panel and actions along the bottom.
--}}
<div class="stl-layout">

  <aside class="stl-sidebar">
    <header class="stl-sidebar-header">
      <span class="stl-sidebar-title">{{localize "STL.Browser.Categories"}}</span>
      <span class="stl-count">{{totalImages}}</span>
    </header>

    <ul class="stl-categories">
      {{#each categories}}
        <li>
          <button type="button"
                  class="stl-category{{#if this.active}} active{{/if}}"
                  data-action="selectCategory"
                  data-category-id="{{this.id}}">
            <span class="stl-category-label">{{this.label}}</span>
            <span class="stl-count">{{this.count}}</span>
          </button>
        </li>
      {{else}}
        <li class="stl-empty">{{localize "STL.Browser.NoCategories"}}</li>
      {{/each}}
    </ul>

    {{#if isGM}}
      <footer class="stl-sidebar-footer">
        <button type="button" data-action="addCategory">
          <i class="fas fa-plus"></i> {{localize "STL.Browser.AddCategory"}}
        </button>
        <button type="button" data-action="refresh" data-tooltip="{{localize 'STL.Browser.RefreshHint'}}">
          <i class="fas fa-rotate"></i>
        </button>
      </footer>
    {{/if}}
  </aside>

  <section class="stl-main">

    <header class="stl-filters">
      {{#if category}}
        <div class="stl-filter-rows">
          {{#each facets}}
            <div class="stl-filter-row">
              <span class="stl-filter-label">{{this.label}}</span>
              <div class="stl-chips">
                {{#each this.values}}
                  <button type="button"
                          class="stl-chip{{#if this.selected}} selected{{/if}}"
                          data-action="toggleFacet"
                          data-facet-id="{{../id}}"
                          data-value="{{this.value}}">{{this.value}}</button>
                {{/each}}
              </div>
            </div>
          {{else}}
            <p class="stl-hint">
              {{#if untagged}}
                {{localize "STL.Browser.NoFacetsButUntagged"}}
              {{else}}
                {{localize "STL.Browser.NoFacets"}}
              {{/if}}
            </p>
          {{/each}}
        </div>

        <div class="stl-filter-actions">
          <span class="stl-match-count">
            {{localize "STL.Browser.Matching"}}: <strong>{{matchCount}}</strong>
            {{#if untagged}}
              · <span class="stl-untagged">{{untagged}} {{localize "STL.Browser.Untagged"}}</span>
            {{/if}}
          </span>
          {{#if hasFilter}}
            <button type="button" data-action="clearFilters">
              <i class="fas fa-filter-circle-xmark"></i> {{localize "STL.Browser.ClearFilters"}}
            </button>
          {{/if}}
          {{#if isGM}}
            <button type="button" data-action="editCategory" data-tooltip="{{localize 'STL.Browser.EditCategory'}}">
              <i class="fas fa-pen-to-square"></i>
            </button>
          {{/if}}
        </div>
      {{/if}}
    </header>

    {{#if needsFrame}}
      <p class="stl-warning">
        <i class="fas fa-triangle-exclamation"></i> {{localize "STL.Browser.NoFrameChosen"}}
      </p>
    {{/if}}

    <div class="stl-grid">
      {{#each images}}
        <button type="button"
                class="stl-thumb{{#if this.selected}} selected{{/if}}"
                data-action="selectImage"
                data-path="{{this.path}}"
                data-tooltip="{{this.tooltip}}">
          <img src="{{this.path}}" alt="{{this.filename}}" loading="lazy">
          {{#if this.readOnly}}<i class="fas fa-lock stl-thumb-badge"></i>{{/if}}
          {{#if this.untagged}}<i class="fas fa-tag stl-thumb-badge stl-thumb-untagged"></i>{{/if}}
        </button>
      {{else}}
        <p class="stl-empty">{{localize "STL.Browser.NoImages"}}</p>
      {{/each}}
    </div>

    {{#if hasMore}}
      <button type="button" class="stl-load-more" data-action="loadMore">
        {{localize "STL.Browser.LoadMore"}} ({{shownCount}} / {{matchCount}})
      </button>
    {{/if}}

    {{#if isGM}}
      <div class="stl-selection-bar">
        <span class="stl-selection-count">
          {{#if selectedCount}}
            {{localize "STL.Browser.Selected"}}: <strong>{{selectedCount}}</strong>
          {{else}}
            <span class="stl-hint-inline">{{localize "STL.Browser.SelectHint"}}</span>
          {{/if}}
        </span>
        <button type="button" data-action="selectAll">{{localize "STL.Browser.SelectAll"}}</button>
        {{#if selectedCount}}
          <button type="button" data-action="clearSelection">{{localize "STL.Browser.ClearSelection"}}</button>
          <button type="button" data-action="removeImages">
            <i class="fas fa-circle-minus"></i> {{localize "STL.Remove.Action"}}
          </button>
        {{/if}}
        {{#if removedCount}}
          <button type="button" data-action="restoreRemoved"
                  data-tooltip="{{localize 'STL.Remove.RestoreHint'}}">
            <i class="fas fa-rotate-left"></i> {{localize "STL.Remove.Restore"}} ({{removedCount}})
          </button>
        {{/if}}
      </div>

      {{#if selectedCount}}
        <div class="stl-tag-panel">
          {{#if hasTagFacets}}
            <span class="stl-tag-label">{{localize "STL.Tag.Assign"}}</span>
            {{#each tagFacets}}
              <label class="stl-tag-field">
                <span>{{this.label}}</span>
                <select data-tag-facet="{{this.id}}">
                  <option value="__keep__">{{localize "STL.Tag.Keep"}}</option>
                  <option value="__clear__">{{localize "STL.Tag.Clear"}}</option>
                  {{#each this.values}}
                    <option value="{{this}}">{{this}}</option>
                  {{/each}}
                </select>
              </label>
            {{/each}}
            <button type="button" class="stl-primary" data-action="applyTags">
              <i class="fas fa-tags"></i> {{localize "STL.Tag.Apply"}}
            </button>
          {{else}}
            <span class="stl-hint-inline">{{localize "STL.Tag.NoFacets"}}</span>
            <button type="button" data-action="editCategory">
              <i class="fas fa-plus"></i> {{localize "STL.Category.AddFacet"}}
            </button>
          {{/if}}
        </div>
      {{/if}}
    {{/if}}

    <footer class="stl-actions">
      <span class="stl-mode" data-tooltip="{{localize 'STL.Browser.ModeHint'}}">
        <i class="fas fa-circle-notch"></i> {{modeLabel}}{{#if variantLabel}} — {{variantLabel}}{{/if}}
      </span>

      <div class="stl-action-buttons">
        {{#if isGM}}
          <button type="button" data-action="addImages">
            <i class="fas fa-file-import"></i> {{localize "STL.Browser.AddImages"}}
          </button>
          {{#if needsProcessing}}
            <button type="button" data-action="bakeSet">
              <i class="fas fa-fire"></i> {{localize "STL.Browser.BakeSet"}}
            </button>
          {{/if}}
        {{/if}}
        <button type="button" data-action="applyToTokens" {{#unless selectedTokens}}disabled{{/unless}}>
          <i class="fas fa-bullseye"></i> {{localize "STL.Browser.ApplyToTokens"}} ({{selectedTokens}})
        </button>
        <button type="button" class="stl-primary" data-action="applyToActor">
          <i class="fas fa-user-check"></i> {{localize "STL.Browser.ApplyToActor"}}
        </button>
      </div>
    </footer>

  </section>
</div>
